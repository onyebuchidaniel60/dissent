# Dissent MVP configuration template. Never commit actual secrets.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Dissent

# PostgreSQL (Neon in preview). DATABASE_URL may be pooled; the direct URL is used by pg-boss.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dissent
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/dissent
PG_BOSS_SCHEMA=pgboss
DISABLE_IN_PROCESS_QUEUE=false

# Session signing. Wallet connect is the only human auth path; no email/password.
AUTH_SECRET=replace-with-a-long-random-secret
# Must exactly match APP_BASE_URL. Production preview: https://dissent-web.onrender.com
AUTH_RECIPIENT=http://localhost:3000
ADMIN_WALLET_ADDRESSES=

# NEAR mainnet production template. The live preview falls back to
# config/preview-network.json (testnet) when mainnet accounts are missing.
# Supply operator-owned account IDs and keys for mainnet.
# The preview/staging environment may explicitly override these with testnet IDs.
NEAR_NETWORK=mainnet
NEXT_PUBLIC_NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
NEAR_EXPLORER_URL=https://explorer.near.org
NEAR_DEPLOYER_ACCOUNT_ID=
NEAR_DEPLOYER_KEY=
NEAR_REGISTRY_ACCOUNT_ID=
NEAR_ESCROW_ACCOUNT_ID=
NEAR_PAYOUT_ACCOUNT_ID=
DEMO_CLIENT_ACCOUNT_ID=
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_KEY=
NEAR_CLIENT_SIGNING_MODE=AGENT_SUPPLIED_TX

# Model providers. One OpenAI-compatible adapter, configurable base URL.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
MAX_COST_PER_AUDIT_USD=0.5
MAX_DAILY_INFERENCE_USD=0.5
MAX_CONCURRENT_AUDITS=1
MAX_PARALLEL_ATTACKERS=3

# Phase 16 autonomous compute procurement (x402). Disabled by default.
# The agent pays A01/A02 inference with testnet USDC through the self-hosted shim.
# Use testnet-only keys here; never a mainnet full-access key. The reference
# facilitator URL is recorded for interoperability, but settlement is in-process.
X402_SHIM_ENABLED=false
X402_AGENT_ACCOUNT_ID=
X402_AGENT_KEY=
X402_FACILITATOR_URL=
X402_PAY_TO_ACCOUNT_ID=
X402_USDC_TOKEN_ID=
X402_PRICE_ATOMIC=2000
X402_MAX_OUTPUT_TOKENS=4096
X402_ATTACKERS=A01,A02
X402_RELAYER_ACCOUNT_ID=
X402_RELAYER_KEY=
OPENROUTER_X402_PROXY_URL=
GROQ_X402_PROXY_URL=

# TEE gate is formally waived under the zero-new-spend constraint.
TEE_VERIFICATION_ENABLED=false
TEE_STATUS=WAIVED_BUDGET_CONSTRAINT

# Optional evidence adapters (public endpoints work without keys; keys raise limits).
FASTNEAR_API_KEY=
NEARBLOCKS_API_KEY=

# Demo video voiceover. Never commit the key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

DEMO_MODE=false
LOG_LEVEL=info

# Phase 11 proprietary execution. Mainnet 1Click is the primary venue;
# EXECUTION_ENABLED and PROPRIETARY_LOOP_ENABLED remain false by default.
NEAR_VAULT_ACCOUNT_ID=
NEAR_VAULT_AGENT_ACCOUNT_ID=
NEAR_VAULT_AGENT_KEY=
EXECUTION_VENUE=ONECLICK
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=
ONECLICK_ORIGIN_ASSET=nep141:wrap.near
ONECLICK_DESTINATION_ASSET=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
ONECLICK_WNEAR_TOKEN_ID=wrap.near
ONECLICK_DEPOSIT_ADDRESS=
VAULT_SUPPORTS_NEP141=false
EXECUTION_ENABLED=false
PROPRIETARY_LOOP_ENABLED=false
VAULT_PER_TX_CAP_YOCTO=500000000000000000000000
VAULT_DAILY_CAP_YOCTO=1000000000000000000000000
PROPRIETARY_THESIS_AMOUNT_YOCTO=10000000000000000000000
# The loop signs commit_audit and fund_audit as this account. Use a testnet-only
# full-access key here, never a mainnet key. DEMO_CLIENT_KEY is the fallback.
PROPRIETARY_CLIENT_ACCOUNT_ID=
PROPRIETARY_CLIENT_KEY=
PROPRIETARY_RECIPIENT=
PROPRIETARY_REFUND_TO=
PROPRIETARY_EXECUTION_AUDIT_ID=
PROPRIETARY_LIVE_ACK=

# Staging-only testnet venue. Leave these empty in production.
TIDEPOOL_BASE_URL=
TIDEPOOL_DEPOSIT_ADDRESS=
TIDEPOOL_WNEAR_TOKEN_ID=wnear.tidepool-sandbox.testnet
TIDEPOOL_ORIGIN_ASSET=nep141:wnear.tidepool-sandbox.testnet
TIDEPOOL_DESTINATION_ASSET=nep141:usdc.tidepool-sandbox.testnet
